{
  "appId": "com.datascience.datacleaner",
  "appName": "Data Cleaner",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0a1a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#0a0a1a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
